# AgentRelease Lab — example environment. Copy to .env and fill in. No secrets here.
# Database (PostgreSQL 16 + pgvector)
POSTGRES_DB=agentreleaselab
POSTGRES_USER=arl
POSTGRES_PASSWORD=change-me-in-dev-only
DATABASE_URL=jdbc:postgresql://postgres:5432/agentreleaselab
# Redis
REDIS_URL=redis://redis:6379/0
# Platform API
PLATFORM_PORT=8080
# Agent worker
WORKER_PORT=8001
WORKER_API_KEY=change-me-worker-key
# LLM provider (OpenAI-compatible). Leave blank to use fixture mode only.
# Fixture mode is deterministic and labeled; it is NOT live AI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Embeddings: 'fixture' (deterministic hash-based, labeled) or provider name
EMBEDDING_MODE=fixture
# OpenTelemetry (optional; leave blank to log spans locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Demo seed admin API key (dev only; rotate for any shared deployment)
SEED_ADMIN_API_KEY=arl-admin-demo-key
# --- Deployment (pilot) settings. Placeholders only — fill from the secret
# manager at deploy time into .env.deploy (never commit real values).
# See docs/DEPLOYMENT.md. Service identity contract (platform + worker):
# ARL_MODE, ARL_OIDC_ENABLED, ARL_OIDC_ISSUER, ARL_OIDC_AUDIENCE, ARL_OIDC_JWKS_URI.
ARL_MODE=deployment
ARL_OIDC_ENABLED=true
ARL_OIDC_ISSUER=
ARL_OIDC_AUDIENCE=
ARL_OIDC_JWKS_URI=
# Comma-separated exact origins for CORS in deployment mode (no wildcards).
ARL_CORS_ALLOWED_ORIGINS=
# Path to the generated secrets env file used by docker-compose.deploy.yml
# (default .env.deploy). Alternative: point at a file rendered by SOPS/age.
ARL_SECRETS_ENV_FILE=.env.deploy
