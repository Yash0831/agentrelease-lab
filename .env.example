# AgentRelease Lab — example environment. Copy to .env and fill in. No secrets here.
# Database (PostgreSQL 16 + pgvector)
POSTGRES_DB=agentreleaselab
POSTGRES_USER=arl
POSTGRES_PASSWORD=change-me-in-dev-only
DATABASE_URL=jdbc:postgresql://postgres:5432/agentreleaselab
# Redis
REDIS_URL=redis://redis:6379/0
# Platform API
PLATFORM_PORT=8080
# Agent worker
WORKER_PORT=8001
WORKER_API_KEY=change-me-worker-key
# LLM provider (OpenAI-compatible). Leave blank to use fixture mode only.
# Fixture mode is deterministic and labeled; it is NOT live AI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Embeddings: 'fixture' (deterministic hash-based, labeled) or provider name
EMBEDDING_MODE=fixture
# OpenTelemetry (optional; leave blank to log spans locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Demo seed admin API key (dev only; rotate for any shared deployment)
SEED_ADMIN_API_KEY=arl-admin-demo-key
